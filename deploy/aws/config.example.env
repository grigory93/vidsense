# VidSense — AWS create/destroy parameters (non-secret).
#
# Copy to config.env and edit for your account. config.env is gitignored.
#
#   cp deploy/aws/config.example.env deploy/aws/config.env
#   $EDITOR deploy/aws/config.env
#
# These are the knobs create.sh / destroy.sh / backup-vm.sh read. Fill them in
# from the output of scan.sh (deploy/aws/inventory/) so a rebuild matches what
# actually ran. Nothing here is a secret — real secrets (.env, Caddy basicauth,
# API keys) live only on the VM and in your password manager, never in git.

# ---------------------------------------------------------------------------
# Core placement
# ---------------------------------------------------------------------------
# AWS region the VM + Elastic IP live in. The EIP must be in the same region as
# the instance. Find it in the scan summary ("region" of the vidsense instance).
AWS_REGION=us-east-1

# Optional named profile. Leave blank to use the default credential chain
# (env vars / SSO / instance profile).
AWS_PROFILE=

# Tag applied to every resource create.sh makes, and the selector destroy.sh
# uses. Do not change between create and destroy or teardown will miss things.
PROJECT_TAG=vidsense

# ---------------------------------------------------------------------------
# EC2 instance
# ---------------------------------------------------------------------------
# Name tag for the instance and its security group.
# Live scan 2026-09-07: instance Name=vidsense-dev-t3med, SG=launch-wizard-3.
INSTANCE_NAME=vidsense-dev-t3med
SECURITY_GROUP_NAME=launch-wizard-3

# Instance size. Live scan 2026-09-07: t2.medium (the Name tag says t3med).
INSTANCE_TYPE=t2.medium

# Root EBS volume. gp3 / 20 GiB matches docs/deployment-aws.md.
ROOT_VOLUME_SIZE_GB=20
ROOT_VOLUME_TYPE=gp3

# Ubuntu 24.04 LTS AMI is looked up at run time by name pattern (see below), so
# we never pin a stale AMI ID. Override only if the scan shows a different base.
AMI_NAME_PATTERN=ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*
# Canonical's AWS account ID — owner filter for the AMI lookup. Rarely changes.
AMI_OWNER=099720109477

# ---------------------------------------------------------------------------
# SSH access
# ---------------------------------------------------------------------------
# EC2 key pair. create.sh REUSES KEY_PAIR_FILE if it exists (never overwrites
# it) and imports the public half into AWS if the named pair is missing.
# destroy.sh does not delete the AWS key pair.
# Live scan 2026-09-07: pair vidsensed-dev matches ~/.ssh/vidsensed-dev.pem
# (the IdentityFile for Host vidsense-dev in ~/.ssh/config).
KEY_PAIR_NAME=vidsensed-dev
KEY_PAIR_FILE=~/.ssh/vidsensed-dev.pem

# CIDR allowed to reach SSH (port 22). GitHub-hosted deploy runners use a wide,
# changing IP range, so the current setup relies on the deploy job reaching the
# VM over 22. Confirm the real value from the scan; do NOT blindly use
# 0.0.0.0/0. If deploys come only from GitHub Actions, prefer locking this to
# your admin IP and running deploys via workflow_dispatch, or accept the
# documented trade-off.
SSH_INGRESS_CIDR=0.0.0.0/0

# Login user for SSH after bootstrap (matches deploy/bootstrap.sh service user).
SERVICE_USER=vidsense
# Default login user on the Ubuntu AMI (used before bootstrap runs).
AMI_LOGIN_USER=ubuntu

# ---------------------------------------------------------------------------
# DNS (optional)
# ---------------------------------------------------------------------------
# Public domain for the site. Used for the Route 53 A record and smoke tests.
DOMAIN=vidsense.info

# If you use Route 53, set the hosted zone ID (from the scan). Leave blank to
# skip all Route 53 changes (e.g. domain managed at an external registrar).
# Live scan 2026-09-07: hosted zone for vidsense.info.
ROUTE53_ZONE_ID=Z09014773OXLG8IMZNHX8

# Extra A records (space-separated) that also pointed at the Elastic IP.
# Live scan 2026-09-07: vidsense.vidsense.info in addition to the apex.
EXTRA_A_RECORDS=vidsense.vidsense.info

# ---------------------------------------------------------------------------
# Git source for bootstrap
# ---------------------------------------------------------------------------
REPO_URL=https://github.com/grigory93/vidsense.git
REPO_BRANCH=main
