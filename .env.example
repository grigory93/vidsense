# LLM Provider Configuration
# Supported: openai, google, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Per-task model overrides (optional — falls back to LLM_MODEL if unset)
# LLM_MODEL_SUMMARIES=gpt-4o
# LLM_MODEL_CHAPTERS=gpt-4o
# LLM_MODEL_MIND_MAP=gpt-4o-mini
# LLM_MODEL_GLOSSARY=gpt-4o-mini
# LLM_MODEL_QA=gpt-4o-mini

# Embedding model (used for Semantic Q&A; requires openai/google/ollama provider)
EMBEDDING_MODEL=text-embedding-3-small

# API Keys (set only the one matching your LLM_PROVIDER)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (if using local models)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./vidsense.db

# App Settings
APP_DEBUG=false
APP_SECRET_KEY=change-me-in-production
